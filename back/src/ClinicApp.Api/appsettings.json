{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "Auth": {
    "Issuer": "clinicapp",
    "Audience": "clinicapp",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "SessionRefreshHours": 12,
    "PasswordResetMinutes": 60,
    "InvitationHours": 72
  },
  "Clinic": {
    "TimeZone": "America/Guayaquil"
  },
  "Notifications": {
    "Provider": "",
    "ReminderHoursBefore": 24,
    "DispatchIntervalSeconds": 10
  },
  "Attachments": {
    "RootPath": "",
    "OrphanHours": 24,
    "CleanupIntervalMinutes": 60,
    "Retention": {
      "RemovedDays": null,
      "DryRun": true
    }
  },
  "AllowedHosts": "*"
}
