{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "IncludeScopes": true
      }
    }
  },
  "Auth": {
    "Issuer": "clinicapp",
    "Audience": "clinicapp",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "PasswordResetMinutes": 60
  },
  "AllowedHosts": "*"
}
