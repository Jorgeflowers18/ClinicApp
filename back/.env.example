# Copiar este archivo como .env (en la misma carpeta back/) y ajustar si hace falta.
# El archivo .env no se sube al repositorio. En el servidor: chmod 600 .env (solo lo lee su dueño).

# ─────────────── Base de datos (desarrollo y servidor) ───────────────
POSTGRES_DB=clinicapp
POSTGRES_USER=clinicapp
# En el servidor, una contraseña larga y aleatoria (openssl rand -base64 32). Sin ";" (va dentro de la cadena
# de conexión).
POSTGRES_PASSWORD=clinicapp_dev
# Puerto en esta máquina (solo 127.0.0.1).
POSTGRES_PORT=5433
# DB_MEM_LIMIT=512m

# ─────────────── API en Docker (solo en el servidor) ───────────────
# En desarrollo se deja comentado: "docker compose up -d" levanta solo la base y la API se corre con dotnet run.
# COMPOSE_PROFILES=api

# Clave para firmar los JWT: mínimo 32 caracteres, aleatoria (openssl rand -base64 48). Si cambia, todas las
# sesiones abiertas se cierran.
# AUTH_SIGNING_KEY=

# URL pública del front, sin "/" al final (enlaces de contraseña y CORS). Ej.: https://clinica.midominio.com
# FRONTEND_URL=

# Dominios que la API acepta en el encabezado Host, separados por ";". Incluir localhost para probar con curl
# desde el servidor. Ej.: clinica.midominio.com;localhost;127.0.0.1   (por defecto *, cualquiera)
# ALLOWED_HOSTS=

# Administrador inicial: se crea al arrancar si ese correo no existe (contraseña de 12 caracteres o más).
# Después del primer despliegue se pueden borrar estas dos líneas.
# SEED_ADMIN_EMAIL=
# SEED_ADMIN_PASSWORD=
# SEED_ADMIN_NAME=Administrador

# Puerto de la API en esta máquina (solo 127.0.0.1); nginx redirige /api aquí.
# API_PORT=5000
# API_MEM_LIMIT=512m

# Imagen de la API: por defecto se construye en el servidor. Si se publica en un registro (por ejemplo,
# ghcr.io/usuario/clinicapp-api), se indica aquí con su etiqueta y se usa "docker compose pull".
# API_IMAGE=clinicapp-api
# API_IMAGE_TAG=latest

# Red interna de Docker. Cambiarla solo si choca con otra red del servidor.
# DOCKER_SUBNET=172.30.0.0/24

# Proveedor de notificaciones: vacío = no se envían ni registran (todavía no hay proveedor).
# NOTIFICATIONS_PROVIDER=
