VITE_API_BASE_URL=http://localhost:5000/api

# true: modo demostración (mocks en el navegador). false: todos los módulos usan la API.
VITE_USE_MOCK_API=true

# Conectar módulos de a uno mientras VITE_USE_MOCK_API=true, en el orden de docs/planes-implementacion:
# auth, institution, patients, agenda, treatments, inventory, clinical-history, notifications, finance, reports
# Ejemplo: VITE_API_MODULES=auth,institution
VITE_API_MODULES=
