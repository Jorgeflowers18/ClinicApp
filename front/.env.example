# Dirección de la API. Se lee al compilar (npm run build).
# Desarrollo: la API de "dotnet run".
# Producción (VPS): no se toca este archivo ni front/.env; se crea front/.env.production.local (git lo ignora) con
#   VITE_API_BASE_URL=/api
# porque el front y la API están en el mismo dominio detrás de nginx. Ver documentacion/proceso-despliegue-prod.md.
VITE_API_BASE_URL=http://localhost:5000/api
